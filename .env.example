# Copy to .env (next to docker-compose.yml) and uncomment any value to override it.
# .env is git-ignored; never commit it.

# Watchtower update schedule: 6-field cron, seconds first
# (second minute hour day month weekday).
# Default: "0 0 * * * *" (hourly, on the hour).
# WATCHTOWER_SCHEDULE="0 0 * * * *"
